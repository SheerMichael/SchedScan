# .env.example - Template for environment variables

# === LOCAL DEVELOPMENT ===
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database (Local PostgreSQL)
DB_NAME=schedscan
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# API Base URL for frontend
API_URL=http://127.0.0.1:8000

# CORS (set to True for local development)
CORS_ALLOW_ALL=True

# === PRODUCTION (DigitalOcean App Platform) ===
# Use these in DigitalOcean environment variables:
#
# DJANGO_SECRET_KEY=<generate-new-secure-key>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=${APP_DOMAIN}
# DATABASE_URL=${db.DATABASE_URL}
# CORS_ALLOW_ALL=False
#
# Production API URL: https://schedscan-5gfy.ondigitalocean.app

# === EXTRACTION PIPELINE (Staging/Production) ===
# Recommended baseline for first rollout: keep student/faculty thresholds equal.
# Tune faculty values only after telemetry review.
EXTRACTION_ACCEPT_THRESHOLD_STUDENT=0.85
EXTRACTION_ACCEPT_THRESHOLD_FACULTY=0.85
EXTRACTION_RETRY_THRESHOLD_STUDENT=0.60
EXTRACTION_RETRY_THRESHOLD_FACULTY=0.60
EXTRACTION_SCORE_VERSION=v1
EXTRACTION_RULE_VERSION=v1
EXTRACTION_SCHEMA_VERSION=v1

# === STRIPE PAYMENT (Test Mode) ===
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key_here

# === FILE STORAGE (DigitalOcean Spaces) ===
# Only needed in production — local dev uses filesystem by default
# DO_SPACES_KEY=your-spaces-access-key
# DO_SPACES_SECRET=your-spaces-secret-key
# DO_SPACES_BUCKET=schedscan-files
# DO_SPACES_REGION=sgp1